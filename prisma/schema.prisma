// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  AGENT
  CUSTOMER
}

enum Plan {
  FREE
  PRO
  TEAM
}

model PlanConfig {
  plan       Plan @id
  maxSeats   Int? // null = unlimited
  maxTickets Int? // null = unlimited
  
  @@map("plan_configs")
}

enum TicketStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ─────────────────────────────────────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────────────────────────────────────

/// A Company represents a single tenant in the multi-tenant system.
/// All other data is scoped to a Company via companyId.
model Company {
  id        String   @id @default(cuid())
  name      String
  /// URL-safe slug for the public ticket submission link, e.g. "techcognify"
  slug      String   @unique
  plan      Plan     @default(FREE)
  needsOnboarding Boolean @default(false)
  createdAt DateTime @default(now())

  // Stripe Billing Fields
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  // Relations
  users        User[]
  tickets      Ticket[]
  replies      Reply[]
  attachments  Attachment[]
  activityLogs ActivityLog[]
  inviteTokens InviteToken[]

  @@map("companies")
}

/// A User belongs to exactly one Company and has a role within that company.
model User {
  id              String   @id @default(cuid())
  name            String?
  email           String   @unique
  passwordHash    String? // null for OAuth-only users
  role            Role     @default(CUSTOMER)
  companyId       String
  /// Platform-level superuser flag. Only settable via direct DB access.
  /// Grants access to /admin (platform overview). NOT the same as Role.ADMIN.
  isPlatformOwner Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  submittedTickets Ticket[]       @relation("TicketCustomer")
  assignedTickets  Ticket[]       @relation("TicketAgent")
  replies          Reply[]
  activityLogs     ActivityLog[]
  notifications    Notification[]

  @@index([companyId])
  @@index([email])
  @@map("users")
}

/// A Ticket is a support request created by a CUSTOMER and optionally assigned to an AGENT.
model Ticket {
  id              String         @id @default(cuid())
  subject         String
  description     String
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(NORMAL)
  companyId       String
  customerId      String
  assignedAgentId String?
  /// Soft-delete flag. true = archived (hidden from normal views). Orthogonal to status.
  archived        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // AI Triage Fields
  aiSummary        String?
  aiCategory       String?
  aiSuggestedReply String?

  // Relations
  company       Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      User         @relation("TicketCustomer", fields: [customerId], references: [id])
  assignedAgent User?        @relation("TicketAgent", fields: [assignedAgentId], references: [id])
  replies       Reply[]
  attachments   Attachment[]

  trackingToken String @unique @default(dbgenerated("gen_random_uuid()"))

  @@index([companyId])
  @@index([customerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([archived])
  @@map("tickets")
}

/// A Reply is a message posted on a Ticket by any user (customer or agent).
model Reply {
  id        String   @id @default(cuid())
  message   String
  ticketId  String
  userId    String
  companyId String
  createdAt DateTime @default(now())

  // Relations
  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([companyId])
  @@map("replies")
}

/// An Attachment is a file uploaded in relation to a Ticket.
model Attachment {
  id         String   @id @default(cuid())
  fileUrl    String
  fileName   String
  ticketId   String
  companyId  String
  uploadedAt DateTime @default(now())

  // Relations
  ticket  Ticket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([companyId])
  @@map("attachments")
}

/// ActivityLog tracks audit events scoped to a company (e.g., ticket created, user assigned).
model ActivityLog {
  id        String   @id @default(cuid())
  action    String // e.g. "ticket.created", "ticket.assigned", "reply.added"
  targetId  String? // ID of the resource this action targets (e.g. ticket ID)
  companyId String
  userId    String
  createdAt DateTime @default(now())

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@map("activity_logs")
}

/// A single-use token for inviting a new team member (AGENT) to a workspace.
/// Expires 72 hours after creation. Marked usedAt when accepted.
model InviteToken {
  id        String    @id @default(cuid())
  token     String    @unique // cryptographically random, URL-safe
  email     String // invitee's email address
  role      Role      @default(AGENT)
  companyId String
  expiresAt DateTime
  usedAt    DateTime? // null = still valid
  createdAt DateTime  @default(now())

  // Relations
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([companyId])
  @@map("invite_tokens")
}

/// In-App Notifications for users
model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String? // Optional URL to redirect to when clicked
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
